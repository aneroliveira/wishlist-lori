# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca faça commit do arquivo preenchido com valores reais.

# --- Banco de dados (Neon Postgres) ---
# Connection string pooled (host com "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Login único (é só pra você) ---
# String aleatória longa usada para criptografar o cookie de sessão (min. 32 caracteres).
SESSION_SECRET=""
# Hash bcrypt da sua senha. No Next.js, escape cada "$" do hash como "\$"
# (ex.: "\$2b\$12\$...") ou o valor carregado em runtime fica corrompido.
ADMIN_PASSWORD_HASH=""
